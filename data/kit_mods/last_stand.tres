[gd_resource type="Resource" script_class="KitModData" format=3]

[ext_resource type="Script" path="res://resources/kit_mod_data.gd" id="1_mod"]

[resource]
script = ExtResource("1_mod")
id = &"last_stand"
display_name = "Dernier souffle"
description = "Sous 30 % de PV : +20 % de vitesse, -25 % de dégâts subis, rechargement / sortie de l'arme / visée 20 % plus rapides. Capacités toujours 15 % plus lentes."
tier = 2
effects = {
"ability_cooldown_mult": 0.15,
"low_hp_damage_taken_mult": -0.25,
"low_hp_handling_mult": -0.2,
"low_hp_speed_mult": 0.2,
"low_hp_threshold": 0.3
}
